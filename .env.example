# Copy to `.env` for local development, or set these in Vercel. Names only: fill in your own values. Never commit real values.

# Postgres connection string. Local: your database URL. Vercel: Supabase transaction pooler (port 6543, ends ?pgbouncer=true).
DATABASE_URL=""

# Signs session tokens. Use any long random string.
AUTH_SECRET=""

# Name of the session cookie.
SESSION_COOKIE_NAME=""

# Password for the seeded demo accounts. Not currently read by app code; the demo sign-in accepts no password.
DEMO_PASSWORD=""

# AI provider keys. The app uses GROQ_API_KEY first, then ANTHROPIC_API_KEY.
GROQ_API_KEY=""
ANTHROPIC_API_KEY=""

# UPI ID shown in sent invoice messages.
UPI_ID=""

# Set to "true" to run the app on mock data. Both names are read.
NEXT_PUBLIC_MOCK_MODE=""
MOCK_MODE=""

# Build output directory override (Nexen preview tooling only).
NEXEN_DIST_DIR=""
